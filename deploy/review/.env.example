# Copy outside Git. Generate distinct secrets; do not reuse personal library logins.
REVIEW_REVISION=replace-with-reviewed-git-revision
REVIEW_CATALOGUE_FILE=/srv/bookseerr-review/catalogue.json
REVIEW_ASSETS_PATH=/srv/bookseerr-review/assets
REVIEW_BIND_ADDRESS=127.0.0.1
REVIEW_APP_PORT=15057
REVIEW_READER_PORT=13001
REVIEW_SUBNET=172.31.95.0/24
REVIEW_SOURCE_IP=172.31.95.10
REVIEW_VPN_IP=172.31.95.5
BOOKSEERR_PUBLIC_URL=https://review.example.com
BOOKSEERR_ADMIN_USERNAME=review-admin
BOOKSEERR_ADMIN_PASSWORD=
BOOKSEERR_SESSION_SECRET=
BOOKORBIT_PUBLIC_URL=https://reader-review.example.com
BOOKORBIT_USERNAME=review-connector
BOOKORBIT_PASSWORD=
BOOKORBIT_LIBRARY_IDS=
CHAPTARR_API_KEY=
CHAPTARR_EBOOK_QUALITY_PROFILE_ID=
CHAPTARR_EBOOK_METADATA_PROFILE_ID=
REVIEW_POSTGRES_PASSWORD=
REVIEW_READER_JWT=
REVIEW_READER_BOOTSTRAP=
REVIEW_READER_ENCRYPTION_KEY=
REVIEW_WIREGUARD_PRIVATE_KEY=
REVIEW_WIREGUARD_ADDRESSES=
REVIEW_VPN_PROVIDER=surfshark
REVIEW_VPN_COUNTRIES=Canada
# Pin VPN and downloader images to the inspected official image digests for deployment.
REVIEW_VPN_IMAGE=qmcgaw/gluetun:latest
REVIEW_QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent:latest
