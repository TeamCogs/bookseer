# Run with Docker Compose. Keep this file private after copying it to .env.
BOOKSEER_PORT=5057
BOOKSEER_ADMIN_USERNAME=admin
# Generate with: openssl rand -hex 24
BOOKSEER_ADMIN_PASSWORD=
# Generate a DIFFERENT value with: openssl rand -hex 32
BOOKSEER_SESSION_SECRET=
# Set true when using HTTPS at your reverse proxy.
BOOKSEER_SECURE_COOKIES=false
# An optional complete origin, for example https://books.example.com
BOOKSEER_PUBLIC_URL=

# Server-to-server URLs. Use service names on a shared Docker network,
# or an address reachable FROM the Bookseer container. localhost means Bookseer itself.
BOOKORBIT_URL=
BOOKORBIT_PUBLIC_URL=
BOOKORBIT_USERNAME=
BOOKORBIT_PASSWORD=
# Leave empty to read all libraries visible to this account; otherwise comma-separated IDs.
BOOKORBIT_LIBRARY_IDS=

CHAPTARR_URL=
CHAPTARR_PUBLIC_URL=
CHAPTARR_API_KEY=
# Chaptarr request dispatch remains disabled until a root folder and profiles are set.
CHAPTARR_EBOOK_ROOT_FOLDER=
CHAPTARR_AUDIOBOOK_ROOT_FOLDER=
CHAPTARR_EBOOK_QUALITY_PROFILE_ID=
CHAPTARR_EBOOK_METADATA_PROFILE_ID=
CHAPTARR_AUDIOBOOK_QUALITY_PROFILE_ID=
CHAPTARR_AUDIOBOOK_METADATA_PROFILE_ID=

BOOKSEER_SYNC_INTERVAL_MINUTES=30
BOOKSEER_INVENTORY_MAX_AGE_HOURS=24
# Optional, descriptive contact for Open Library's API. Never put a secret here.
OPEN_LIBRARY_CONTACT=
